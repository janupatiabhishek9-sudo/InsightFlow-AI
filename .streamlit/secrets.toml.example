# Paste this into Streamlit Community Cloud: App -> Settings -> Secrets.
# (Locally, put the same values in .env instead. Never commit real secrets.)

LLM_PROVIDER = "groq"
LLM_MODEL = "openai/gpt-oss-120b"
GROQ_API_KEY = "gsk_your_key_here"
TOKEN_BUDGET = "25000"

# Admin page password (choose a long random one)
ADMIN_PASSWORD = "change-me-to-a-long-random-password"

# Starting access codes: CODE[:max_uses[:YYYY-MM-DD]], comma-separated.
# These always come back after the app restarts; codes created in the admin page may not.
COUPONS = "PYTHON2026:100:2026-12-31"
REQUIRE_COUPON = "true"
PROJECT_ENABLED = "true"
