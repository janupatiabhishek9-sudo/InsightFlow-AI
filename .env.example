# ---- LLM -------------------------------------------------------------------------------------
# Just paste ONE key below. With LLM_PROVIDER=auto the first key found is used, in this order:
#   anthropic, openai, gemini, groq, mistral, deepseek, openrouter, together, xai, custom
# No key at all = offline deterministic reasoner (rule_based). Check your setup with:
#   python -m app.llm.check
LLM_PROVIDER=auto
# Leave empty for the provider's default model, or name any model your account offers.
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
TOKEN_BUDGET=60000
# Optional AI review of computed results: adds up to 3 unverified notes, costs ~4k tokens.
# Set false on tight free tiers to save tokens and time.
LLM_RESULT_REVIEW=true

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
XAI_API_KEY=

# Local models: set LLM_PROVIDER=ollama (small quantized model on 8 GB RAM, e.g. LLM_MODEL=qwen2.5:3b)
OLLAMA_BASE_URL=http://localhost:11434

# Any other OpenAI-compatible server (vLLM, LM Studio, LiteLLM, Azure OpenAI v1 endpoint, ...)
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=

# ---- RAG -------------------------------------------------------------------------------------
# hashing: dependency-free lexical embedder (default). fastembed:<model> requires `pip install fastembed`
EMBEDDING_MODEL=hashing
VECTOR_DB_PATH=data/processed/vector_store
KNOWLEDGE_DIR=knowledge
# Highest document access level the default user may read: public | internal | restricted
DEFAULT_USER_CLEARANCE=internal

# ---- Data ------------------------------------------------------------------------------------
DATA_DIR=data
MAX_UPLOAD_MB=100
# Workflow checkpoints; paused approvals survive restarts. "memory" = not persisted.
CHECKPOINT_DB=data/processed/checkpoints.sqlite

# ---- Agent loop control ----------------------------------------------------------------------
MAX_TOOL_CALLS=12
MAX_RETRIES=2
MAX_PLAN_STEPS=8
MAX_EXECUTION_TIME=120
QUERY_TIMEOUT=15
MAX_RESULT_ROWS=500
SANDBOX_TIMEOUT=20
SANDBOX_MEMORY_MB=1024

# ---- UI --------------------------------------------------------------------------------------
# local: Streamlit runs the service in-process (one process, lowest RAM). http: call the FastAPI server.
UI_BACKEND=local
API_URL=http://localhost:8000

# ---- API authentication ------------------------------------------------------------------------
# Empty = auth off (local development). Format: name:key:role:clearance, comma-separated.
# Roles: viewer (read) < analyst (upload, investigate) < approver (+ approve/reject). Keys >= 16 chars.
# API_KEYS=alice:change-me-long-random-key-1:approver:restricted,bob:change-me-long-random-key-2:analyst:internal
API_KEYS=
# The key the Streamlit UI sends when UI_BACKEND=http
API_KEY=

# ---- Observability ---------------------------------------------------------------------------
LOG_LEVEL=INFO
ENABLE_LANGSMITH=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=insightflow-ai
