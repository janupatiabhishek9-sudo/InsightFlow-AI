# ---- LLM ----
# rule_based: deterministic reasoner, no model needed (default, fully offline)
# openai: any OpenAI-compatible chat completions endpoint
# ollama: local Ollama server (use a small quantized model on 8 GB RAM, e.g. qwen2.5:3b)
LLM_PROVIDER=rule_based
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=60
TOKEN_BUDGET=60000

# ---- RAG ----
# hashing: dependency-free lexical embedder (default). fastembed:<model> requires `pip install fastembed`
EMBEDDING_MODEL=hashing
VECTOR_DB_PATH=data/processed/vector_store
KNOWLEDGE_DIR=knowledge
# Highest document access level the default user may read: public | internal | restricted
DEFAULT_USER_CLEARANCE=internal

# ---- Data ----
DATA_DIR=data
MAX_UPLOAD_MB=100

# ---- Agent loop control ----
MAX_TOOL_CALLS=12
MAX_RETRIES=2
MAX_PLAN_STEPS=8
MAX_EXECUTION_TIME=120
QUERY_TIMEOUT=15
MAX_RESULT_ROWS=500
SANDBOX_TIMEOUT=20

# ---- UI ----
# local: Streamlit runs the service in-process (one process, lowest RAM). http: call the FastAPI server.
UI_BACKEND=local
API_URL=http://localhost:8000

# ---- Observability ----
LOG_LEVEL=INFO
ENABLE_LANGSMITH=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=insightflow-ai
